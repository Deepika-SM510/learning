
class Book {

    int bookID;
    String title;
    String author;
    double price;

    static int count = 0;

    // Constructor
    Book(int bookID, String title, String author, double price) {
        this.bookID = bookID;
        this.title = title;
        this.author = author;
        this.price = price;

        count++;
    }

    // Display book information
    void display() {
        System.out.println("Book ID: " + bookID);
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
        System.out.println("Price: " + price);
        System.out.println("----------------------");
    }

    // Search by Book ID
    static Book search(Book[] books, int id) {
        for (int i = 0; i < books.length; i++) {
            if (books[i].bookID == id) {
                return books[i];
            }
        }
        return null;
    }

    // Overloaded search method: Search by Title
    static Book search(Book[] books, String title) {
        for (int i = 0; i < books.length; i++) {
            if (books[i].title.equalsIgnoreCase(title)) {
                return books[i];
            }
        }
        return null;
    }

    // Return the costlier book
    Book costlier(Book b) {
        if (this.price > b.price) {
            return this;
        } else {
            return b;
        }
    }

    // Display total number of books
    static void displayCount() {
        System.out.println("Total books created: " + count);
    }
}

public class Main {

    public static void main(String[] args) {

        // Creating multiple Book objects
        Book b1 = new Book(101, "Java", "James", 500);
        Book b2 = new Book(102, "Python", "Guido", 700);
        Book b3 = new Book(103, "C++", "Bjarne", 1000);
        Book b4 = new Book(104, "HTML", "Tim", 300);

        Book[] books = {b1, b2, b3, b4};

        // Display all books
        System.out.println("----- ALL BOOK DETAILS -----");

        for (int i = 0; i < books.length; i++) {
            books[i].display();
        }

        // Search by Book ID
        System.out.println("\n----- SEARCH BY BOOK ID -----");

        Book result1 = Book.search(books, 102);

        if (result1 != null) {
            result1.display();
        } else {
            System.out.println("Book not found!");
        }

        // Search by Title
        System.out.println("\n----- SEARCH BY TITLE -----");

        Book result2 = Book.search(books, "C++");

        if (result2 != null) {
            result2.display();
        } else {
            System.out.println("Book not found!");
        }

        // Find costliest book among all objects
        Book costliest = books[0];

        for (int i = 1; i < books.length; i++) {
            costliest = costliest.costlier(books[i]);
        }

        System.out.println("\n----- COSTLIEST BOOK -----");
        costliest.display();

        // Display total number of books
        Book.displayCount();

    }
}
